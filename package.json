  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev -- npx vite",
    "dev:client": "vite",
    "dev:legacy": "concurrently --kill-others --kill-others-on-fail \"npm run server\" \"vite\"",
    "server": "node server/api.cjs",
    "build": "npm run build:skill && tsc -b && vite build",
    "build:skill": "npx tsx scripts/bundle-xuan-skill.ts",
    "preview": "wrangler pages dev ./dist",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "db:migrate": "wrangler d1 migrations apply iching64-db",
    "db:migrate:local": "wrangler d1 migrations apply iching64-db --local",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
